# Application Configuration
APP_NAME=QuranYutla
APP_ENV=development
HTTP_ENABLE=true
HTTP_HOST=localhost
HTTP_PORT=3777
HTTP_VERSIONING_ENABLE=true
HTTP_VERSION=1
# Public base URL of this API, used to build the AI webhook callback URL.
# MUST be reachable from the AI service (not localhost once deployed).
# Production example: https://api.yutlaquran.com
APP_URL=http://localhost:3777

# Set to "true" ONLY during the review period to auto-create the 4 demo accounts
# (student/parent/teacher/admin, password Quran@2026) on boot. Leave unset/false
# in normal production. See review-accounts/ for details.
SEED_REVIEW_ACCOUNTS=false

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=54556
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=quran_yutla

# Docker PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quran_yutla
POSTGRES_PORT=54556
NETWORK_NAME=quran_yutla

# JWT Configuration
JWT_SECRET=your-256-bit-secure-key-change-this-in-production
JWT_VERIFICATION_SECRET=your-256-bit-secure-verification-key-change-this
JWT_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_SECRET=your-256-bit-secure-refresh-key-change-this
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Mail Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Quran Yutla Support <your-email@gmail.com>"

# OVH Cloud Storage Configuration
# See docs/OVH-Storage-Setup-Guide.md for detailed setup
OVH_REGION=gra
OVH_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
OVH_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
OVH_BUCKET_NAME=quran-yutla-container
OVH_BASE_URL=https://quran-yutla-container.s3.gra.io.cloud.ovh.net
MAX_SIZE_FILE_UPLOAD=100
IMAGE_QUALITY=80

# Paymob Payment Gateway Configuration
# Register at: https://accept.paymob.com/portal2/en/register
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID_CARD=your_card_integration_id
PAYMOB_INTEGRATION_ID_WALLET=your_wallet_integration_id
PAYMOB_HMAC_SECRET=your_hmac_secret_here
PAYMOB_CURRENCY=EGP
PAYMENT_SUCCESS_URL=http://localhost:3777/payment/success
PAYMENT_FAILURE_URL=http://localhost:3777/payment/failed

# OneSignal Notification (Development)
ONE_SIGNAL_API_KEY=your_onesignal_api_key
ONE_SIGNAL_APP_ID=your_onesignal_app_id
LOGO_URL=https://example.com/logo.png

# Security (production)
# Comma-separated allowed browser origins. Unset = CORS fully open (dev only).
# Example: CORS_ORIGIN=https://app.yutlaquran.com,https://admin.yutlaquran.com
CORS_ORIGIN=
# Secret guarding the /errors log-dump endpoint. Unset = endpoint disabled.
# The endpoint exposes request bodies, so leave it unset unless you need it.
LOGS_SECRET=

# AI Service Configuration
# URL of the AI service for Quran recitation evaluation
AI_SERVICE_URL=http://localhost:5000
# API key for authenticating requests to AI service.
# SHARED: must be the exact same value on the AI service side, or it answers 401.
AI_API_KEY=your_ai_service_api_key_here
# Secret for validating webhook callbacks from the AI service.
# NOT shared: we send it in every request and the AI service echoes it back in
# the callback's Authorization header. Generate your own and keep it private:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production — the app refuses to boot when it is empty, because an
# empty value silently rejects every callback and loses every evaluation.
AI_WEBHOOK_SECRET=your_webhook_secret_key_here
# Request timeout in milliseconds (default: 30000 = 30 seconds)
AI_REQUEST_TIMEOUT=30000
