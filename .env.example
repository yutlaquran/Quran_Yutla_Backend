# Application Configuration
APP_NAME=QuranYutla
APP_ENV=development
HTTP_ENABLE=true
HTTP_HOST=localhost
HTTP_PORT=3777
HTTP_VERSIONING_ENABLE=true
HTTP_VERSION=1
# Public base URL of this API, used to build the AI webhook callback URL.
# MUST be reachable from the AI service (not localhost once deployed).
# Production example: https://api.quranyutla.com
APP_URL=http://localhost:3777

# Beta stop-gap: grant every user an active subscription the moment they verify
# their email, because Paymob is not live yet and they would otherwise be unable
# to record anything. TURN THIS OFF the day real payments work — leaving it on
# hands out free plans forever. Granted rows carry paymentMethod='free-beta' so
# they can be found and revoked later.
FREE_SUBSCRIPTION_ON_VERIFY=false

# Set to "true" ONLY during the review period to auto-create the 4 demo accounts
# (student/parent/teacher/admin, password Quran@2026) on boot. Leave unset/false
# in normal production. See review-accounts/ for details.
SEED_REVIEW_ACCOUNTS=false

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=54556
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=quran_yutla

# Docker PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quran_yutla
POSTGRES_PORT=54556
NETWORK_NAME=quran_yutla

# JWT Configuration
JWT_SECRET=your-256-bit-secure-key-change-this-in-production
JWT_VERIFICATION_SECRET=your-256-bit-secure-verification-key-change-this
JWT_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_SECRET=your-256-bit-secure-refresh-key-change-this
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Mail Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Quran Yutla Support <your-email@gmail.com>"

# Object Storage (S3-compatible)
# Which provider the STORAGE_* values below describe: ovh | r2
# ovh -> objects are made public per-object (ACL: public-read)
# r2  -> no per-object ACLs; the bucket is exposed via a custom domain
STORAGE_PROVIDER=ovh

# --- Option A: OVH Object Storage --- (see docs/OVH-Storage-Setup-Guide.md)
STORAGE_REGION=gra
STORAGE_ENDPOINT=https://s3.gra.io.cloud.ovh.net
STORAGE_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
STORAGE_SECRET_KEY=YOUR_SECRET_KEY_HERE
STORAGE_BUCKET=quran-yutla-container
STORAGE_PUBLIC_URL=https://quran-yutla-container.s3.gra.io.cloud.ovh.net

# --- Option B: Cloudflare R2 --- (see docs/Cloudflare-R2-Setup-Guide.md)
# Zero egress fees, which is what actually matters for an audio-heavy app.
# STORAGE_PROVIDER=r2
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
# STORAGE_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
#
# TWO buckets, not one. R2 has no per-object ACL — connecting a custom domain
# to a bucket exposes EVERY object in it, unauthenticated, by key. A shared
# bucket would make recitation audio (private) fetchable the same way as
# avatars (public). Keep them apart:
# STORAGE_BUCKET=quran-yutla                # private: recitations, presigned-only, NO custom domain
# STORAGE_PUBLIC_BUCKET=quran-yutla-public  # public: avatars, Quran audio, has the custom domain
#
# Must be the PUBLIC bucket's custom domain, NOT the throttled *.r2.dev URL.
# STORAGE_PUBLIC_URL=https://cdn.quranyutla.com

# Legacy names (OVH_REGION, OVH_ENDPOINT, OVH_ACCESS_KEY, OVH_SECRET_ACCESS_KEY,
# OVH_BUCKET_NAME, OVH_BASE_URL) are still read as a fallback if STORAGE_* is unset.

# Lifetime (seconds) of the signed URLs handed out for recitation audio.
# Recitations are uploaded PRIVATE — a child's recorded voice is never a
# permanent public link — so every API response signs the URL on the way out.
STORAGE_SIGNED_URL_TTL=3600

MAX_SIZE_FILE_UPLOAD=100
IMAGE_QUALITY=80

# Paymob Payment Gateway Configuration
# Register at: https://accept.paymob.com/portal2/en/register
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID_CARD=your_card_integration_id
PAYMOB_INTEGRATION_ID_WALLET=your_wallet_integration_id
PAYMOB_HMAC_SECRET=your_hmac_secret_here
PAYMOB_CURRENCY=EGP
PAYMENT_SUCCESS_URL=http://localhost:3777/payment/success
PAYMENT_FAILURE_URL=http://localhost:3777/payment/failed

# OneSignal Notification (Development)
ONE_SIGNAL_API_KEY=your_onesignal_api_key
ONE_SIGNAL_APP_ID=your_onesignal_app_id
LOGO_URL=https://example.com/logo.png

# Security (production)
# Comma-separated allowed browser origins. Unset = CORS fully open (dev only).
# Example: CORS_ORIGIN=https://app.quranyutla.com,https://admin.quranyutla.com
CORS_ORIGIN=
# Secret guarding the /errors log-dump endpoint. Unset = endpoint disabled.
# The endpoint exposes request bodies, so leave it unset unless you need it.
LOGS_SECRET=

# AI Service Configuration
# URL of the AI service for Quran recitation evaluation
AI_SERVICE_URL=http://localhost:5000
# API key for authenticating requests to AI service.
# SHARED: must be the exact same value on the AI service side, or it answers 401.
AI_API_KEY=your_ai_service_api_key_here
# Secret for validating webhook callbacks from the AI service.
# NOT shared: we send it in every request and the AI service echoes it back in
# the callback's Authorization header. Generate your own and keep it private:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production — the app refuses to boot when it is empty, because an
# empty value silently rejects every callback and loses every evaluation.
AI_WEBHOOK_SECRET=your_webhook_secret_key_here
# Request timeout in milliseconds (default: 30000 = 30 seconds)
AI_REQUEST_TIMEOUT=30000
